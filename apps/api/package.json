{
  "name": "@nr/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/server.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "npm run build -w @nr/shared && tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx --env-file=../../.env src/scripts/migrate.ts",
    "bootstrap:owner": "tsx --env-file=../../.env src/scripts/bootstrap-owner.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@node-rs/argon2": "^2.0.2",
    "@nr/shared": "*",
    "fastify": "^5.2.1",
    "kysely": "^0.28.5",
    "nodemailer": "^9.0.5",
    "pg": "^8.14.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.13",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
