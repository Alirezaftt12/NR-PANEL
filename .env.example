NODE_ENV=development
DEMO_MODE=false
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://nrpanel:replace-with-local-development-password@localhost:5432/nrpanel
REDIS_URL=redis://localhost:6379

# Use at least 32 cryptographically random bytes. It is used as the session-token HMAC pepper.
SESSION_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-bytes
# Separate AES-GCM key material used for recoverable Xray client credentials.
CONFIG_ENCRYPTION_KEY=replace-with-a-separate-cryptographically-random-secret-of-at-least-32-bytes
SUBSCRIPTION_PUBLIC_BASE_URL=http://localhost:4000/api/v1/sub
SESSION_TTL_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=3600
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

MASTER_PUBLIC_URL=http://localhost:3000
NR_PANEL_NODE_INSTALL_URL=https://raw.githubusercontent.com/Alirezaftt12/NR-PANEL/main/node-install.sh
SERVER_JOIN_TTL_SECONDS=900
NEXT_PUBLIC_API_URL=/api/v1
INTERNAL_API_URL=http://localhost:4000/api/v1
