#!/usr/bin/env bash
# shellcheck disable=SC1090,SC2016
set -Eeuo pipefail
CONFIG_DIR=/etc/nr-panel
RESULT_FILE=$CONFIG_DIR/install-result.env
COMPOSE_ENV=$CONFIG_DIR/compose.env
COMPOSE_FILE=/opt/nr-panel/current/deployment/compose/compose.production.yml
LIB=/opt/nr-panel/current/deployment/installer/lib.sh
[[ $EUID -eq 0 ]] || { printf 'Run nr-panel with sudo.\n' >&2; exit 1; }
[[ -r $LIB && -r $COMPOSE_ENV ]] || { printf 'NR PANEL installation metadata is unavailable.\n' >&2; exit 1; }
NR_PANEL_INSTALL_LIB_ONLY=1 source "$LIB"
compose(){ docker compose --env-file "$COMPOSE_ENV" -f "$COMPOSE_FILE" "$@"; }
load_result(){ [[ -r $RESULT_FILE ]] || nr_die "Install result not found"; set -a; source "$RESULT_FILE"; set +a; }
show_access(){ load_result; printf 'Panel URL: %s\nPort: %s\nPath: /%s/\nUsername: %s\n' "$PANEL_URL" "$PANEL_PORT" "$PANEL_PATH" "$OWNER_USERNAME"; }
status(){ compose ps; systemctl --no-pager --full status nr-agent.service || true; }
reset_password(){ local value="${1:-}"; [[ -n $value ]] || value="$(nr_random_secret 24)"; export NEW_OWNER_PASSWORD="$value"; compose run --rm -e NEW_OWNER_PASSWORD api node apps/api/dist/scripts/reset-owner.js >/dev/null; unset NEW_OWNER_PASSWORD; printf 'New OWNER password (shown once): %s\n' "$value"; }
reset_username(){ local value="${1:-}"; [[ -n $value ]] || value="nr_$(openssl rand -hex 8)"; [[ ${#value} -ge 10 ]] || nr_die "Username must have at least 10 characters"; export NEW_OWNER_USERNAME="$value"; compose run --rm -e NEW_OWNER_USERNAME api node apps/api/dist/scripts/reset-owner.js >/dev/null; unset NEW_OWNER_USERNAME; nr_atomic_env_set "$RESULT_FILE" OWNER_USERNAME "$value"; printf 'New OWNER username: %s\n' "$value"; }
change_port(){ local new="${1:-}"; [[ -n $new ]] || read -r -p 'New panel port: ' new; nr_port_free "$new" || nr_die "Port is invalid or occupied"; load_result; local old="$PANEL_PORT" old_url="$PANEL_URL" url origin subscription; url="$(nr_compose_url "$PANEL_SCHEME" "$PANEL_HOST" "$new" "$PANEL_PATH")"; origin="$PANEL_SCHEME://$(nr_url_host "$PANEL_HOST"):$new"; subscription="$origin/api/v1/sub"; nr_atomic_env_set "$COMPOSE_ENV" PANEL_PORT "$new"; nr_atomic_env_set "$RESULT_FILE" PANEL_PORT "$new"; nr_atomic_env_set "$RESULT_FILE" PANEL_URL "$url"; nr_atomic_env_set "$CONFIG_DIR/production.env" WEB_ORIGIN "$origin"; nr_atomic_env_set "$CONFIG_DIR/production.env" SUBSCRIPTION_PUBLIC_BASE_URL "$subscription"; nr_atomic_env_set "$CONFIG_DIR/production.env" MASTER_PUBLIC_URL "${url%/}"; compose up -d --force-recreate proxy api; for _ in {1..20}; do curl -fsS "http://127.0.0.1:$new/healthz" >/dev/null && { printf 'New Panel URL: %s\n' "$url"; return; }; sleep 2; done; nr_atomic_env_set "$COMPOSE_ENV" PANEL_PORT "$old"; nr_atomic_env_set "$RESULT_FILE" PANEL_PORT "$old"; nr_atomic_env_set "$RESULT_FILE" PANEL_URL "$old_url"; nr_atomic_env_set "$CONFIG_DIR/production.env" WEB_ORIGIN "$PANEL_SCHEME://$(nr_url_host "$PANEL_HOST"):$old"; nr_atomic_env_set "$CONFIG_DIR/production.env" SUBSCRIPTION_PUBLIC_BASE_URL "$PANEL_SCHEME://$(nr_url_host "$PANEL_HOST"):$old/api/v1/sub"; nr_atomic_env_set "$CONFIG_DIR/production.env" MASTER_PUBLIC_URL "${old_url%/}"; compose up -d --force-recreate proxy api; nr_die "New port health check failed; previous port restored"; }
change_path(){ local new="${1:-}"; [[ -n $new ]] || read -r -p 'New web path: ' new; new="$(nr_normalize_path "$new")" || nr_die "Path must contain 18-64 URL-safe characters"; load_result; local old="$PANEL_PATH" old_url="$PANEL_URL" url; nr_atomic_env_set "$COMPOSE_ENV" PANEL_PATH "$new"; nr_atomic_env_set "$RESULT_FILE" PANEL_PATH "$new"; url="$(nr_compose_url "$PANEL_SCHEME" "$PANEL_HOST" "$PANEL_PORT" "$new")"; nr_atomic_env_set "$RESULT_FILE" PANEL_URL "$url"; nr_atomic_env_set "$CONFIG_DIR/production.env" MASTER_PUBLIC_URL "${url%/}"; compose up -d --force-recreate proxy api; for _ in {1..20}; do curl -fsS "http://127.0.0.1:$PANEL_PORT/$new/" >/dev/null && { printf 'New Panel URL: %s\n' "$url"; return; }; sleep 2; done; nr_atomic_env_set "$COMPOSE_ENV" PANEL_PATH "$old"; nr_atomic_env_set "$RESULT_FILE" PANEL_PATH "$old"; nr_atomic_env_set "$RESULT_FILE" PANEL_URL "$old_url"; nr_atomic_env_set "$CONFIG_DIR/production.env" MASTER_PUBLIC_URL "${old_url%/}"; compose up -d --force-recreate proxy api; nr_die "New path health check failed; previous path restored"; }
backup(){ local file; mkdir -p /var/backups/nr-panel; file="/var/backups/nr-panel/nr-panel-$(date -u +%Y%m%dT%H%M%SZ).sql.gz"; compose exec -T postgres pg_dump -U nrpanel nrpanel | gzip -9 >"$file"; sha256sum "$file" >"$file.sha256"; chmod 600 "$file" "$file.sha256"; printf 'Backup: %s\n' "$file"; }
diagnostics(){ status; compose exec -T postgres pg_isready -U nrpanel -d nrpanel; compose exec -T redis sh -c 'redis-cli -a "$REDIS_PASSWORD" ping' | sed 's/.*/Redis: HEALTHY/'; load_result; curl -fsS "http://127.0.0.1:$PANEL_PORT/healthz" && printf '\nProxy: HEALTHY\n'; }
remove_fixed_tree(){ local target="$1" expected="$2" resolved; [[ -d $target ]] || return 0; resolved="$(realpath -e -- "$target")"; [[ $resolved == "$expected" ]] || nr_die "Refusing to remove unexpected path: $resolved"; rm -rf --one-file-system -- "$resolved"; }
uninstall_panel(){ printf 'Type REMOVE APPLICATION to continue: '; read -r confirmation; [[ $confirmation == 'REMOVE APPLICATION' ]] || nr_die "Cancelled"; compose down; systemctl disable --now nr-agent.service || true; rm -f /etc/systemd/system/nr-agent.service /usr/local/bin/nr-panel; systemctl daemon-reload; remove_fixed_tree /opt/nr-panel /opt/nr-panel; remove_fixed_tree /etc/nr-panel /etc/nr-panel; printf 'Application and configuration removed. Persistent data and backups were preserved.\n'; printf 'Remove persistent data too? Type DELETE ALL NR PANEL DATA: '; read -r second; if [[ $second == 'DELETE ALL NR PANEL DATA' ]]; then remove_fixed_tree /var/lib/nr-panel /var/lib/nr-panel; printf 'Persistent data removed. Backups remain in /var/backups/nr-panel.\n'; fi; }
update_panel(){ backup; /opt/nr-panel/current/deployment/installer/install.sh --update; }
menu(){ while true; do printf '\n1. Status\n2. Start Panel\n3. Stop Panel\n4. Restart Panel\n5. Show Panel Access\n6. Reset OWNER Username\n7. Reset OWNER Password\n8. Change Panel Port\n9. Change Web Base Path\n10. TLS / Certificate\n11. View Logs\n12. Database Status\n13. Agent Status\n14. Xray Status\n15. Backup\n16. Update\n17. Diagnostics\n18. Uninstall\n0. Exit\n> '; read -r choice; case "$choice" in 1)status;;2)compose up -d;;3)compose stop;;4)compose restart;;5)show_access;;6)reset_username;;7)reset_password;;8)change_port;;9)change_path;;10)printf 'TLS is configured only with an explicit validated certificate; see docs/installation.md.\n';;11)compose logs --tail=200; journalctl -u nr-agent.service -n 100 --no-pager;;12)compose exec -T postgres pg_isready -U nrpanel -d nrpanel;;13)systemctl status nr-agent.service --no-pager;;14)docker exec nr-panel-agent sh -c 'test -x /host/usr/local/bin/xray && /host/usr/local/bin/xray version || echo NOT_INSTALLED';;15)backup;;16)update_panel;;17)diagnostics;;18)uninstall_panel;;0)return;;*)printf 'Invalid choice\n';;esac; done; }
case "${1:-menu}" in status)status;;start)compose up -d;;stop)compose stop;;restart)compose restart;;show-access)show_access;;reset-password)reset_password "${2:-}";;reset-username)reset_username "${2:-}";;change-port)change_port "${2:-}";;change-path)change_path "${2:-}";;logs)compose logs --tail=200; journalctl -u nr-agent.service -n 100 --no-pager;;backup)backup;;update)update_panel;;diagnostics)diagnostics;;uninstall)uninstall_panel;;menu|'')menu;;*)nr_die "Unknown command";;esac
