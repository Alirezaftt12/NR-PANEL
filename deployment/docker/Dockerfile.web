FROM node:22.17.1-alpine3.22 AS build
WORKDIR /app
COPY package*.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY agent/package.json agent/package.json
RUN npm ci
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_API_URL=/api/v1
RUN npm run build -w @nr/shared && npm run build -w @nr/web

FROM node:22.17.1-alpine3.22 AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
RUN addgroup -S nrpanel && adduser -S -G nrpanel nrpanel
COPY --from=build --chown=nrpanel:nrpanel /app/apps/web/.next/standalone ./
COPY --from=build --chown=nrpanel:nrpanel /app/apps/web/.next/static ./apps/web/.next/static
USER nrpanel
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
