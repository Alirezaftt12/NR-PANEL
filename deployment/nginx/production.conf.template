server {
  listen 8080;
  server_name _;
  client_max_body_size 2m;
  proxy_hide_header X-Powered-By;
  location = /healthz { access_log off; return 200 'ok'; add_header Content-Type text/plain; }
  location = /${PANEL_PATH} { return 308 /${PANEL_PATH}/; }
  location ^~ /${PANEL_PATH}/api/v1/agents/ { rewrite ^/${PANEL_PATH}(/api/.*)$ $1 break; proxy_pass http://api:4000; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; }
  location ^~ /api/v1/agents/ { proxy_pass http://api:4000; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; }
  location ^~ /api/ { proxy_pass http://api:4000; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; }
  location ^~ /${PANEL_PATH}/ { rewrite ^/${PANEL_PATH}/?(.*)$ /$1 break; proxy_pass http://web:3000; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; add_header Set-Cookie "nr_panel_entry=${PANEL_PATH}; Path=/; HttpOnly; SameSite=Strict" always; }
  location / { if ($cookie_nr_panel_entry != "${PANEL_PATH}") { return 404; } proxy_pass http://web:3000; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; }
}
